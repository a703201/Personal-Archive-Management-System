*.log
logs/
tmp/
temp/
coverage/
lcov.info
lint-report/
*.prof
*.cpuprofile

# ---- 数据库本地数据 ----
*.sqlite
*.sqlite3
*.db
data/
!data/.gitkeep

# ---- 归档与打包 ----
*.tar
*.tar.gz
*.tgz
*.zip
*.7z
*.rar
dist-packages/

# ---- 工具缓存 ----
.cjpm/
.cache/
.pytest_cache/
__pycache__/
*.pyc

# ---- 临时目录（本地调试产物）----
.probe/
.probe.old/
build.old.*/
build.failed/
tools/cangjie.old.*/
.tmpcap/
dist/
.tmpcap/
dist/

# ---- 运行期数据目录（启动自动生成，不入仓）----
.tmp/
data-attachments/
data-backups/
data-exports/
data-quarantine/
