# ============================================================
# AMS · Git 忽略规则
# ============================================================

# ---- 工作区元数据（本地 AI 助手工作记忆，不应进入仓库）----
.workbuddy/

# ---- 仓颉 SDK / 标准库（体积大、与版本强绑定，绝不入库）----
# tools/cangjie/ 是**开发专用的仓颉编译器副本**（约 945 MB）：
#   放在仓库内是为了让团队成员克隆后无需各自安装 SDK，路径也不含空格。
#   但它是二进制产物，绝不能提交到远程仓库。
# 用 scripts/install-sdk.sh 重建（见该脚本说明）。
tools/cangjie/

# stdx 扩展标准库（若放在仓库内，同样不入库）
tools/cangjie-libs/
tools/cangjie-stdlib/
CangjieLibs/
**/cangjie-sdk/
**/cangjie_sdk/
**/cangjie_stdlib/

# ---- 第三方驱动源码（vendor，用 scripts/install-driver.sh 拉取）----
# opengauss-driver 为 Cangjie-TPC 官方驱动，体积不大但属外部代码，
# 由脚本按需拉取，不进版本库（避免与上游版本脱节）。
tools/vendor/

# ---- 工作区元数据 ----
.workbuddy/
.arts/
.cache/

# ---- 构建产物 ----
# 仓颉
target/
*/target/
*.cjo
*.bc
*.a
*.o
*.obj
*.lib
