const CATALOGS: Record<string, Record<string, string>> = {
  'zh-CN': ZH,
  'en': EN,
  'fr': FR
};

/**
 * 取当前语言的文案；缺失时回退 en → zh-CN → 键本身。
 * @param vars 可选命名占位符，用于「我的角色 {role} · {count} 位成员」这类动态文案；
 *             与 Web 端 web/src/i18n/index.ts 的 t(key, vars) 语义一致。
 */
export function t(key: string, vars?: Record<string, string>): string {
  let out: string = key;
  const lang: string = Settings.lang();
  const cur: Record<string, string> | undefined = CATALOGS[lang];
  if (cur !== undefined) {
    const v: string | undefined = cur[key];
    if (v !== undefined) {
      out = v;
    }
  }
  if (out === key) {
    const en: string | undefined = EN[key];
    if (en !== undefined) {
      out = en;
    }
  }
  if (out === key) {
    const zh: string | undefined = ZH[key];
    if (zh !== undefined) {
      out = zh;
    }
  }
  if (vars !== undefined) {
    const keys: string[] = Object.keys(vars);
    for (let i = 0; i < keys.length; i++) {
      const k: string = keys[i];
      out = out.replaceAll('{' + k + '}', vars[k]);
    }
  }
  return out;
}

/**
 * 构造 t() 的占位符对象。直接传内联对象字面量会触发
 * arkts-no-untyped-obj-literals，故统一经此函数返回类型化 Record。
 * @example t('home.managed', i18nVars([['n', count.toString()]]))
 */
export function i18nVars(pairs: string[][]): Record<string, string> {
  const r: Record<string, string> = {};
  for (let i = 0; i < pairs.length; i++) {
    r[pairs[i][0]] = pairs[i][1];
  }
  return r;
}

/** 分类名（三语），编码口径与 useCatalog.ts 一致。 */
export function categoryNameI18n(code: number): string {
  const v: string | undefined = t('cat.' + code.toString());
  return v === 'cat.' + code.toString() ? '分类 ' + code.toString() : v;
}

/** 状态名（三语），0 草稿 / 1 正常 / 2 已归档 / 3 已删除。 */
export function statusNameI18n(status: number): string {
  const key: string = 'status.' + status.toString();
  const v: string = t(key);
  return v === key ? '其他' : v;
}

/** 任务状态名（三语），0 待处理 / 1 运行中 / 2 成功 / 3 失败 / 4 已取消 / 5 已过期。 */
export function taskStatusName(status: number): string {
  const key: string = 'task.' + status.toString();
  const v: string = t(key);
  return v === key ? status.toString() : v;
}
