# ============================================================
# AMS · 部署期配置模板（参考，不要直接改这个文件）
# ------------------------------------------------------------
# 实际文件是 /app/config/deployment.env，由「首次部署向导」或
# 系统运维 →「部署配置」页写入，位于 compose 的 ams-config 持久卷。
#
# 规则：
#   · 文件里出现的键 > 环境变量 > 代码默认值；
#   · 某个键不写，就继续用环境变量（保持既有部署零回归）；
#   · 按「第一个 =」切分，口令里可以含 = ；
#   · 口令不要包含换行。
#
# 数据库配置保存后需重启服务生效；邮件配置同样在重启后开始投递。
# ============================================================

# ---- 数据库（默认与项目同服务器，由 compose 环境变量提供）----
# DB_HOST=172.28.0.10
# DB_PORT=5432
# DB_NAME=ams
# DB_USER=gaussdb
# DB_PASSWORD=

# ---- 邮件服务（找回密码验证码等）----
# MAIL_ENABLED=false
# MAIL_HOST=smtp.example.com
# MAIL_PORT=465
# MAIL_SECURE=ssl          # ssl(465，smtps) 或 starttls(587)
# MAIL_USER=noreply@example.com
# MAIL_PASSWORD=
# MAIL_FROM=noreply@example.com

# ---- 短信服务（FR-NTF-005；可选）----
# 可选；不配置则短信不发、脚本不投递，行为与旧版一致（provider 为 Noop）。
# 网关需兼容 JSON POST；字段按供应商协议在 deploy/scripts/sms-spool.sh 中调整。
# 下列值可用环境变量覆盖（AMS_SMS_XXX 或同名 SMS_XXX），便于 compose 注入密钥。
# SMS_ENABLED=true        # 总开关（默认 false）：关则后端不写 spool、脚本不投递
# SMS_SPOOL=true          # 启用真实投递后端：后端写 sms-*.job，脚本轮询投递
# SMS_CONSOLE=true        # 联调后端：仅把正文打进日志（优先于 spool，生产勿开）
# SMS_GATEWAY_URL=        # 短信网关 JSON POST 地址
# SMS_APP_KEY=            # 网关应用标识（勿写入真实凭据）
# SMS_APP_SECRET=         # 网关密钥（勿写入真实凭据）
# SMS_SIGN_NAME=          # 短信签名
# SMS_TEMPLATE_ID=        # 短信模板 ID

# ---- 媒体处理（OCR / 缩略图 / 像素水印；纯仓颉进程内，默认关闭）----
# 实现位于 packages/ams-core/src/media/，由 ams-server 进程内同步调用：
# 不需要独立 worker、文件队列、Python 或额外容器，也不新增对外端口。
# 附件明文字节只在进程内内存中处理，不落临时文件。
# AMS_MEDIA_ENABLED=true   媒体能力总开关；默认 false（关闭）。
# AMS_OCR_CONSENT=true     开启即表示「已取得 OCR 隐私同意」；默认 false。
#                          须与 AMS_MEDIA_ENABLED 同时为 true 才自动处理。
# 能力边界（2026-11-08 第四批）：PNG / BMP / baseline + 渐进式 JPEG 支持缩略图 / 像素水印 / OCR；
#   文本型 PDF 抽取文本流，图像型扫描 PDF 由 pdfimage.cj 抽图像流后走三路 OCR（5×7 印刷体 → CJK 220 字点阵 → 手写风格数字）。
#   CJK 仅字典内 220 汉字且为字体点阵、手写仅 10 个近似手写数字；真实草书 / 生僻字 / 强倾斜 / 复杂排版 /
#   加密 PDF / ObjStm·XRef 流 / CMYK / JPEG2000 / CCITT / JBIG2 / 图像掩码不支持，高精度识别仍需外部模型（接口明确返回失败或逐图跳过）。
# 默认值：以下开关全部注释，等价于「默认关闭」；关闭时上传 / 下载 / 预览
#   行为与旧版逐字一致。
# AMS_MEDIA_ENABLED=false
# AMS_OCR_CONSENT=false

# ---- 短信 spool 目录（与上方 SMS_* 网关配置不是同一套键）----
# AMS_SMS_SPOOL_DIR=/app/data-sms/spool

# ---- 初始化状态（向导创建管理员后自动写入，勿手工删除）----
# SETUP_INITIALIZED=true
