# ============================================================
# AMS · 运行期配置模板（不含任何真实密钥）
#
# 用法（任选其一）：
#   A. docker compose 中通过 environment / env_file 注入
#   B. 物理机直接 export 后启动 bin/ams-server
#
# 生产必填项已用 !! 标注；未改默认值仅适用于本地开发。
#
# !! 生产环境必须设置 AMS_ENV=production：后端会执行 SEC-001 门禁，
#    三项密钥/口令只要有任一仍在使用内置开发默认值，进程直接拒绝启动。
#    本模板中的示例值不是密钥，部署时必须替换为随机值。
# ============================================================

# ---- 运行环境 ----
# dev（默认，允许内置开发默认值）/ production（强制显式凭据）
AMS_ENV=production

# ---- HTTP 监听 ----
AMS_HTTP_HOST=0.0.0.0
AMS_HTTP_PORT=8080

# ---- 数据库（openGauss / 兼容 PostgreSQL 协议）----
AMS_DB_HOST=127.0.0.1
AMS_DB_PORT=15432
AMS_DB_NAME=ams
AMS_DB_USER=gaussdb
# !! 生产必须改为强口令；建议另设受限运行时账号：
# AMS_DB_APP_USER=ams_app
# AMS_DB_APP_PASSWORD=<受限角色口令>

# ---- 安全密钥 ----
# !! 生产必须 ≥ 32 字节随机值（令牌签名）
AMS_TOKEN_SECRET=change-me-in-production-at-least-32-bytes
# !! 生产必须改为随机值（密钥加密密钥，派生盲索引/包裹密钥）
AMS_KEK=change-me-in-production

# ---- 前端静态产物目录（留空则自动探测 ./web/dist 或发布包 ./web）----
AMS_WEB_DIR=/app/web

# ---- 媒体处理与短信 spool（默认关闭，以下均为注释示例）----
# OCR / 缩略图 / 像素水印由 ams-server 进程内的纯仓颉引擎完成，
# 不需要独立 worker、Python 或额外容器，也不新增对外端口。
# 两个开关须同时为 true 才自动处理（OCR 隐私显式同意）：
# 能力边界（2026-11-08 第四批）：PNG / BMP / baseline + 渐进式 JPEG、文本型 PDF、图像型扫描 PDF 图像流均可处理；
#   三路 OCR（5×7 印刷体 → CJK 220 字点阵 → 手写风格数字）；CJK 仅字典内 220 汉字且为字体点阵、手写仅 10 个近似手写数字；
#   真实草书 / 生僻字 / 强倾斜 / 复杂排版 / 加密 PDF / CMYK 不支持，高精度识别仍需外部模型（接口明确返回失败或逐图跳过）。
# AMS_MEDIA_ENABLED=false
# AMS_OCR_CONSENT=false
#
# ---- external PP-OCRv5（Linux 运行镜像内置；以下为默认值，一般无需覆盖）----
# AMS_OCR_ENGINE=external        设 builtin 则只用内置三路 OCR
# AMS_OCR_DET_QUAD=1             0=回退旧的轴对齐框；1=旋转四边形 + Unclip + 透视裁平（可识别倾斜文本）
# AMS_OCR_UNCLIP_RATIO=1.6       文本框外扩系数，范围 (0.5, 5)
# AMS_OCR_CHANNEL_ORDER=rgb      仅当换成期望 BGR 的导出版本时改 bgr（det/rec 共用，不做隐式猜测）
# 边界：旋转框路径支持凸四边形；任意凹多边形 / 粘连文本行、倾斜 >45° / 竖排未做方向规整。
# 短信 spool 目录（与 deployment.env 的 SMS_* 网关配置不是同一套键）：
# AMS_SMS_SPOOL_DIR=/app/data-sms/spool
#
# ---- Q2 附件存储平台（方案 A 扩展：多厂商可选 + 本地默认）----
# 平台选择：AMS_STORAGE_PROVIDER（新，优先） / AMS_STORAGE_BACKEND（旧，兼容）
# 可选 code（GET /api/admin/storage/providers 返回完整清单）：
#   local 本地 FS（默认，唯一完全可用）· minio 自建 · huawei 华为云 OBS
#   aliyun 阿里云 OSS · qiniu 七牛 Kodo(S3 兼容网关) · tencent 腾讯云 COS
#   aws AWS S3 · s3 通用 S3 兼容
# AMS_STORAGE_PROVIDER=local
# 也可通过管理接口选择并持久化到 /app/config/deployment.env（重启生效）：
#   PUT /api/admin/storage/config  {"provider":"huawei","endpoint":"...","bucket":"...",...}
#   库内已有附件时禁止改变 provider/endpoint/bucket（防旧 storage_key 失效）
#
# 对象存储通用配置位（生产 AK/SK 由密钥管理注入，不要写进 .env）：
# AMS_S3_ENDPOINT=https://obs.cn-north-4.myhuaweicloud.com
# AMS_S3_BUCKET=ams-attachments
# AMS_S3_REGION=cn-north-4
# AMS_S3_ACCESS_KEY=...
# AMS_S3_SECRET_KEY=...
# AMS_S3_PATH_STYLE=false    不设时由厂商 profile 决定：minio=true，其余云=false
#
# ⚠️ 现状：HMAC-SHA256 与 SigV4 **签名计算**已实现并验证（RFC 4231 / AWS 官方向量），
#    但 S3Transport（HTTP 客户端）仍未接入，故非 local 平台启动会**失败关闭**，
#    不会静默回落 FS、更不会以明文写入。attachments/exports/backups 在对象存储下
#    以键前缀隔离；隔离区（FR-ATT-007）恒定本地 FS。最终选型仍待运维·甲方确认。
