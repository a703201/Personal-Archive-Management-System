# ============================================================
# AMS · docker compose 本地开发变量示例
#
# [!!] 仅本地开发，禁止用于生产，禁止提交真实密钥！
#      本文件是模板（可入库）；真正生效的是同目录的 .env，
#      它已被 .gitignore 屏蔽，绝不提交。生产请用 env_file /
#      Docker secrets 注入随机凭据，并把 AMS_ENV 设为 production，
#      见 deploy/RUNBOOK.md 与 deploy/README.md §凭据与 SEC-001。
#
# 用法（首次部署必做）：
#   cp deploy/compose/.env.example deploy/compose/.env
#   # 按需修改 deploy/compose/.env 后
#   bash deploy/scripts/run-app.sh
#
# compose 会自动读取 compose 文件所在目录的 .env，用来替换
# deploy/compose/docker-compose.yml 里的 ${VAR:?...} / ${VAR:-...}
# 占位符；三个 :? 变量缺任意一个，compose 会直接拒绝启动。
# ============================================================

# ---- 数据库口令（必填，compose 用 :? 强制）----
# 必须与既有 openGauss 命名卷 ams_ogdata 的初始化口令一致，改了会连不上库。
# 注意核对：仓库 scripts/db.py、deploy/scripts/migrate.sh、init-db.sh 的
# 本地开发默认值是 Ams@Gauss2026；若你的卷是用那个口令初始化的，
# 请把下面这行改回那个值（本模板值以实际卷为准）。
AMS_DB_PASSWORD=Ams@Gauss2026

# ---- 令牌签名密钥（必填，≥32 字节）----
# 仅本地开发用的固定 dev 值；生产必须替换为随机值，例如
#   openssl rand -base64 48
AMS_TOKEN_SECRET=dev-only-token-secret-32bytes-minimum-0a1b2c3d

# ---- 密钥加密密钥 KEK（必填）----
# 仅本地开发用的固定 dev 值；生产必须替换为随机值。
# 注意：更换 KEK 会使既有用该 KEK 包裹的密钥/盲索引无法解密，
#       生产运行中不要随意轮换，轮换需配套数据重加密方案。
AMS_KEK=dev-only-kek-change-me-in-production-0a1b2c3d

# ---- 运行环境 ----
# compose 的 ams 服务写的是 AMS_ENV: "${AMS_ENV:-production}"，
# 即「不设就是 production」。这里通过 .env 显式覆盖为 dev：
# 本地不触发后端 SEC-001（production 会强制三个凭据均为显式
# 提供且非内置开发默认值，否则进程拒绝启动）。
# [!!] 生产必须改为 production，并同时替换上面三项为随机值。
AMS_ENV=dev

# ---- Q2 可选 s3 profile（默认不启用）----
# 只有 `docker compose -p ams --profile s3 up -d` 才会创建 MinIO 容器；
# 默认 up -d 不创建，现有部署形态零变化。
# 以下均为注释示例，取消注释前请先读 deploy/config/ams.env.example 的 Q2 段：
# 可选平台见 GET /api/admin/storage/providers（local/minio/huawei/aliyun/qiniu/tencent/aws/s3）。
# HMAC-SHA256 与 SigV4 签名计算已具备，但 HTTP 传输层未接，非 local 仍会失败关闭。
# MINIO_ROOT_USER=ams-dev-minio
# MINIO_ROOT_PASSWORD=change-me-in-production
# AMS_STORAGE_PROVIDER=local
